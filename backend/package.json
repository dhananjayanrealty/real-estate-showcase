{
  "name": "real-estate-backend",
  "version": "1.0.0",
  "description": "Real Estate Property Showcase Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node database/init.js",
    "cleanup-media": "node scripts/cleanup.js",
    "backup-db": "cp database/real_estate.db database/backup_$(date +%Y%m%d_%H%M%S).db",
    "restore-db": "node database/restore.js",
    "migrate": "node database/migrate.js",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "axios": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "form-data": "^4.0.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.12",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
